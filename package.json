{
  "name": "faro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "db:export": "tsx scripts/data.ts export",
    "db:import": "tsx scripts/data.ts import",
    "db:preview": "tsx scripts/data.ts preview"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@astrojs/vercel": "11.0.20",
    "@libsql/client": "0.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "oxc-transform-react": "^0.145.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
